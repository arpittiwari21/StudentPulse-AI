# ─────────────────────────────────────────────────────────────────────────────
# StudentPulse AI — Environment Configuration
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────────────────────

# Flask core
FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# JWT
JWT_SECRET=change-jwt-secret-use-openssl-rand-hex-32
JWT_EXPIRY_HOURS=24

# Database
DATABASE_PATH=studentpulse.db

# AI Provider — set ONE of the following (leave blank to use rule-based fallback)
GEMINI_API_KEY=
GROQ_API_KEY=

# Institution domain enforcement
ALLOWED_DOMAIN=kiet.edu

# Faculty / Admin seed account
ADMIN_EMAIL=faculty@kiet.edu
ADMIN_PASSWORD=Faculty@KIET2024
